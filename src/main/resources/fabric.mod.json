{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://github.com/Camawama/clickclose",
    "issues": "https://github.com/Camawama/clickclose/issues",
    "sources": "https://github.com/Camawama/clickclose"
  },
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.cama.clickclose.ClickClose"
    ]
  },
  "accessWidener": "clickclose.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": ">=${fabric_api_version}"
  },
  "suggests": {
    "jei": ">=19.0.0"
  }
}
